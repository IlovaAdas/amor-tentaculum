<Defs>

	<HediffDef Name="HostTransformBase" Abstract="True">
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(255,20,147)</defaultLabelColor>
		<minSeverity>0.001</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<stages>
			<li>
				<minSeverity>0.001</minSeverity>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="AmorTentaculum.HediffCompProperties_MultipliedSeverityPerDay">
				<modSettingMultiplier>geneticRewriteSpeedFactor</modSettingMultiplier>
				<baseSeverityPerDay>0.5</baseSeverityPerDay>
			</li>
			<li Class="HediffCompProperties_MessageAfterTicks">
				<ticks>60</ticks>
				<letterType>HostPregnancy</letterType>
			</li>
		</comps>
	</HediffDef>
	
  <HediffDef ParentName="HostTransformBase">
    <defName>QueenTransform</defName>
    <comps>
      <li Class="EBSGFramework.HediffCompProperties_CreateOtherHediffs">
        <hediffSets>
          <li>
            <hediffDef>TentacleLimbVagina</hediffDef>
            <validSeverity>0.99</validSeverity>
            <severityPerDay>0</severityPerDay>
            <initialSeverity>1</initialSeverity>
            <bodyPart>Genitals</bodyPart>
          </li>
          <li>
            <hediffDef>TentacleLimbAnus</hediffDef>
            <validSeverity>0.99</validSeverity>
            <severityPerDay>0</severityPerDay>
            <initialSeverity>1</initialSeverity>
            <bodyPart>Anus</bodyPart>
          </li>
          <li>
            <hediffDef>QueenEggIncubation</hediffDef>
            <validSeverity>0~0.2</validSeverity>
            <severityPerDay>-200</severityPerDay>
            <initialSeverity>-1</initialSeverity>
          </li>
        </hediffSets>
      </li>
      <li Class="EBSGFramework.HediffCompProperties_AlterXenotype">
        <xenotypes>
			    <AmorQueenXenotype>1</AmorQueenXenotype>
        </xenotypes>
        <severities>1</severities>
        <setXenotype>False</setXenotype>
      </li>
    </comps>
  </HediffDef>

