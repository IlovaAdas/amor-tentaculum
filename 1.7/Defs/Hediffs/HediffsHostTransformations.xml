<Defs>

	<HediffDef Name="HostTransformBase" Abstract="True">
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(255,20,147)</defaultLabelColor>
		<minSeverity>0.001</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<stages>
			<li>
				<minSeverity>0.001</minSeverity>
				<hungerRateFactorOffset>0.5</hungerRateFactorOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="AmorTentaculum.HediffCompProperties_MultipliedSeverityPerDay">
				<modSettingMultiplier>geneticRewriteSpeedFactor</modSettingMultiplier>
				<baseSeverityPerDay>0.5</baseSeverityPerDay>
			</li>
			<li Class="HediffCompProperties_MessageAfterTicks">
				<ticks>60</ticks>
				<letterType>HostPregnancy</letterType>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_HediffsOnRemoval">
				<hediffsToGive>
					<li>
						<hediffDef>QueenEggIncubation</hediffDef>
						<severity>0</severity>
						<replaceExisting>true</replaceExisting>
					</li>
					<li>
						<hediffDef>BaronessEggIncubation</hediffDef>
						<severity>0</severity>
						<replaceExisting>true</replaceExisting>
					</li>
					<li>
						<hediffDef>NymphEggIncubation</hediffDef>
						<severity>0</severity>
						<replaceExisting>true</replaceExisting>
					</li>
					<li>
						<hediffDef>BaronEggIncubation</hediffDef>
						<severity>0</severity>
						<replaceExisting>true</replaceExisting>
					</li>
				</hediffsToGive>
			</li>
		</comps>
	</HediffDef>

		<!-- Female Hosts-->

	<HediffDef ParentName="HostTransformBase">
		<defName>QueenTransform</defName>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_AlterXenotype">
				<xenotypes>
					<AmorQueenXenotype>1</AmorQueenXenotype>
				</xenotypes>
				<severities>1</severities>
				<setXenotype>False</setXenotype>
			</li>
		</comps>
	</HediffDef>

	<HediffDef ParentName="HostTransformBase">
		<defName>BaronessTransform</defName>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_AlterXenotype">
				<xenotypes>
					<AmorBaronessXenotype>1</AmorBaronessXenotype>
				</xenotypes>
				<severities>1</severities>
				<setXenotype>False</setXenotype>
			</li>
		</comps>
	</HediffDef>

	<HediffDef ParentName="HostTransformBase">
		<defName>NymphTransform</defName>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_AlterXenotype">
				<xenotypes>
					<AmorNymphXenotype>1</AmorNymphXenotype>
				</xenotypes>
				<severities>1</severities>
				<setXenotype>False</setXenotype>
			</li>
		</comps>
	</HediffDef>

		<!-- Male Hosts-->

	<HediffDef ParentName="HostTransformBase">
		<defName>BaronTransform</defName>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_AlterXenotype">
				<xenotypes>
					<AmorBaronXenotype>1</AmorBaronXenotype>
				</xenotypes>
				<severities>1</severities>
				<setXenotype>False</setXenotype>
			</li>
		</comps>
	</HediffDef>

  </Defs>