	<ThingDef ParentName="OrganicProductBase">
		<defName>TentacleSlime</defName>
		
		<!--
		Temporarily converted to non-food so pawns won't just gobble it all up immediately.
		
		<description>A sticky, viscous substance "produced" primarily by Amor Queens. Used for crafting more advanced eggs and implants, but also provides a reasonable amount of nutrition when eaten.  It last indefinitely, so long as it is stored safely.  An extremely valuable resource!</description>
		-->

		<graphicData>
			<texPath>Things/Items/TentacleSlime</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<possessionCount>50</possessionCount>
		<socialPropernessMatters>true</socialPropernessMatters>
		<tradeability>Sellable</tradeability>
		<statBases>
			<MarketValue>5.0</MarketValue>
			<Mass>0.025</Mass>
			<!-- <Nutrition>0.05</Nutrition> -->
		</statBases>

		<!--
		<ingestible>
			<foodType>AnimalProduct</foodType>
			<preferability>MealFine</preferability>
			<joy>0.08</joy>
			<joyKind>Gluttonous</joyKind>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
			<lowPriorityCaravanFood>true</lowPriorityCaravanFood>
			<babiesCanIngest>true</babiesCanIngest>
		</ingestible>
		-->
		
		<thingCategories>
			<li>HostProducedResources</li>
		</thingCategories>
		<allowedArchonexusCount>150</allowedArchonexusCount>
	</ThingDef>

