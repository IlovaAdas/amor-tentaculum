<Defs>

	<!-- Animal Abilities -->

	<!-- Amor Squirmer Resource Abilities -->

	<!-- Manually-Targeted Insertion -->
	
	<AbilityDef ParentName="AbilityTouchBase">
		<defName>AbilityTentacleUnbirth</defName>
		<label>crawl inside</label>
		<description>Commands the Amor Squirmer to crawl inside a Host, adding tentacle resources.</description>
		<iconPath>Abilities/ButtVore</iconPath>
		<category>Tentacle</category>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
		<cooldownTicksRange>5</cooldownTicksRange>
		<aiCanUse>true</aiCanUse>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbilityTouch</verbClass>
			<drawAimPie>false</drawAimPie>
			<range>1</range>
			<warmupTime>2</warmupTime>
			<soundCast>AcidSpray_Resolve</soundCast>
			<targetParams>
				<canTargetPawns>true</canTargetPawns>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="EBSGFramework.CompProperties_AbilityGiveResource">
				<amount>0.01</amount>
				<mainResourceGene>HostTentacleNeed</mainResourceGene>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityAbilityValidator">
				<targetHasAnyOfHediffs>
					<li>TentacleInfestedAnus</li>
				</targetHasAnyOfHediffs>
				<casterHasNoneOfHediffs>
					<li>FullOfTentacles</li>
				</casterHasNoneOfHediffs>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityGiveMultipleHediffs">
				<hediffsToGive>
					<li>
						<hediffDef>TentacleStorage</hediffDef>
						<onlyApplyToSelf>false</onlyApplyToSelf>
						<severity>1</severity>
						<bodyParts>
							<li>Genitals</li>
						</bodyParts>
					</li>
					<li>
						<hediffDef>TentacleSacrifice</hediffDef>
						<onlyApplyToSelf>true</onlyApplyToSelf>
						<replaceExisting>false</replaceExisting>
						<bodyParts>
							<li>Brain</li>
						</bodyParts>
					</li>
					<li>
						<hediffDef>TentacleInfestedAnus</hediffDef>
						<replaceExisting>false</replaceExisting>
						<bodyParts>
							<li>Anus</li>
						</bodyParts>
					</li>
				</hediffsToGive>
			</li>
			<li Class="CompProperties_AbilityFleckOnTarget">
				<fleckDef>Heart</fleckDef>
			</li>
		</comps>
	</AbilityDef>

	<AbilityDef Name="AbilityLarvaEvolveBase" Abstract="True">
		<iconPath>Abilities/LarvalTransformation</iconPath>
		<jobDef>CastAbilityOnThing</jobDef>
		<targetRequired>False</targetRequired>
		<canUseAoeToGetTargets>False</canUseAoeToGetTargets>
		<category>Tentacle</category>
		<stunTargetWhileCasting>True</stunTargetWhileCasting>
		<showPsycastEffects>False</showPsycastEffects>
		<displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<cooldownTicksRange>60</cooldownTicksRange>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<jobDef>CastAbilityOnThing</jobDef>
		<targetRequired>False</targetRequired>
		<stunTargetWhileCasting>True</stunTargetWhileCasting>
		<displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<range>999</range>
			<warmupTime>2.5</warmupTime>
			<drawAimPie>False</drawAimPie>
			<soundCast>AcidSpray_Resolve</soundCast>
			<requireLineOfSight>False</requireLineOfSight>
			<targetParams>
				<canTargetLocations>false</canTargetLocations>
				<canTargetPawns>false</canTargetPawns>
				<canTargetAnimals>false</canTargetAnimals>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetHumans>false</canTargetHumans>
				<canTargetEntities>false</canTargetEntities>
				<canTargetSubhumans>false</canTargetSubhumans>
				<canTargetMechs>false</canTargetMechs>
				<canTargetSelf>true</canTargetSelf>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="EBSGFramework.CompProperties_AbilityRemoveMultipleHediffs">
				<compClass>EBSGFramework.CompAbilityEffect_RemoveMultipleHediffs</compClass>
				<hediffs>
					<li>ReadyToEvolve</li>
				</hediffs>
			</li>
			<li Class="CompProperties_AbilityFleckOnTarget">
				<fleckDef>Heart</fleckDef>
			</li>
		</comps>
	</AbilityDef>
	
	<AbilityDef ParentName="AbilityLarvaEvolveBase">
		<defName>AbilityLarvaEvolveSquirmer</defName>
		<label>evolve into squirmers</label>
		<description>Evolve the Larva into a small handful of Squirmers. Inefficient, but if you need some and don't have Spawners available...</description>
		<comps>
			<li Class="AmorTentaculum.CompProperties_ExtendedAbilityValidator">
				<requiredResearchProjects>
					<li>ATCore</li>
				</requiredResearchProjects>
				<casterHasAnyOfHediffs>
					<li>ReadyToEvolve</li>
				</casterHasAnyOfHediffs>
				<hideGizmo>false</hideGizmo>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityGiveMultipleHediffs">
				<hediffsToGive>
					<li>
						<hediffDef>AbilityLarvaEvolveSquirmer</hediffDef>
						<applyToSelf>true</applyToSelf>
						<replaceExisting>false</replaceExisting>
						<severity>0.001</severity>
					</li>
				</hediffsToGive>
			</li>
		</comps>
	</AbilityDef>

	<AbilityDef ParentName="AbilityLarvaEvolveBase">
		<defName>AbilityLarvaEvolveSpawner</defName>
		<label>evolve into spawner</label>
		<description>Evolve the Larva into an Amor Spawner, which will in turn spawn Amor Squirmers.</description>
		<comps>
			<li Class="AmorTentaculum.CompProperties_ExtendedAbilityValidator">
				<requiredResearchProjects>
					<li>ATHostBasic</li>
				</requiredResearchProjects>
				<casterHasAnyOfHediffs>
					<li>ReadyToEvolve</li>
				</casterHasAnyOfHediffs>
				<hideGizmo>false</hideGizmo>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityGiveMultipleHediffs">
				<hediffsToGive>
					<li>
						<hediffDef>AbilityLarvaEvolveSpawner</hediffDef>
						<applyToSelf>true</applyToSelf>
						<replaceExisting>false</replaceExisting>
						<severity>0.001</severity>
					</li>
				</hediffsToGive>
			</li>
		</comps>
	</AbilityDef>

</Defs>